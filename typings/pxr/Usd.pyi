from collections.abc import Iterator
from typing import Any, overload

class Path:
    def __init__(self, path: str) -> None: ...

class Attribute:
    def __bool__(self) -> bool: ...
    def Set(self, value: Any) -> None: ...
    def Get(self) -> Any: ...
    def IsValid(self) -> bool: ...

class Relationship:
    def SetTargets(self, targets: list[Any]) -> None: ...

class Prim:
    def IsValid(self) -> bool: ...
    def IsA(self, cls: type[Any] | Any) -> bool: ...
    def GetName(self) -> str: ...
    def GetPath(self) -> Path: ...
    def GetParent(self) -> Prim: ...
    def CreateAttribute(
        self,
        name: str,
        type_name: Any,
        custom: bool = ...,
        variability: Any = ...,
    ) -> Attribute: ...
    def GetAttribute(self, name: str) -> Attribute: ...
    def HasProperty(self, name: str) -> bool: ...
    def HasAPI(self, api: type[Any] | Any) -> bool: ...
    def CreateRelationship(self, name: str, custom: bool) -> Relationship: ...

class PrimRange(Iterator[Prim]):
    def __init__(self, prim: Prim) -> None: ...
    def __iter__(self) -> PrimRange: ...
    def __next__(self) -> Prim: ...

class Stage:
    def GetPrimAtPath(self, path: str) -> Prim: ...
    def DefinePrim(self, path: str, type_name: str = ...) -> Prim: ...
    @staticmethod
    def CreateInMemory() -> Stage: ...

class TimeCode:
    @overload
    def __init__(self) -> None: ...
    @overload
    def __init__(self, time: float) -> None: ...
    @staticmethod
    def Default() -> TimeCode: ...
