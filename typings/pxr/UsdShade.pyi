from typing import Any

from pxr import Usd

class Material(Usd.Prim):
    @staticmethod
    def Define(stage: Usd.Stage, path: str) -> Material: ...

class MaterialBindingAPI:
    def __init__(self, prim: Usd.Prim) -> None: ...
    @staticmethod
    def Apply(prim: Usd.Prim) -> MaterialBindingAPI: ...
    def Bind(self, material: Material) -> None: ...
    def ComputeBoundMaterial(self) -> tuple[Material, Any]: ...
