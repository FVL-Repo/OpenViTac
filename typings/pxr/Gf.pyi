from collections.abc import Sequence
from typing import overload

class Vec2f:
    @overload
    def __init__(self) -> None: ...
    @overload
    def __init__(self, x: float, y: float) -> None: ...
    def __getitem__(self, index: int) -> float: ...

class Vec3f:
    @overload
    def __init__(self) -> None: ...
    @overload
    def __init__(self, x: float, y: float, z: float) -> None: ...
    def __getitem__(self, index: int) -> float: ...

class Vec3d:
    @overload
    def __init__(self) -> None: ...
    @overload
    def __init__(self, x: float, y: float, z: float) -> None: ...
    def __getitem__(self, index: int) -> float: ...

class Quatf:
    def __init__(self, real: float, imaginary: Vec3f) -> None: ...
    def GetReal(self) -> float: ...
    def GetImaginary(self) -> Vec3f: ...

class Quatd:
    def __init__(self, real: float, imaginary: Vec3d) -> None: ...
    def GetReal(self) -> float: ...
    def GetImaginary(self) -> Vec3d: ...

class Matrix4d:
    def __init__(self, value: float = ...) -> None: ...
    def __getitem__(self, row: int) -> Sequence[float]: ...
    def __mul__(self, other: Matrix4d) -> Matrix4d: ...
    def GetInverse(self) -> Matrix4d: ...
    def SetRotateOnly(self, quat: Quatd) -> None: ...
    def SetTranslateOnly(self, vec: Vec3d) -> None: ...
    def ExtractTranslation(self) -> Vec3d: ...
    def ExtractRotationQuat(self) -> Quatd: ...
