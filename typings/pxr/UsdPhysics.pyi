from typing import Any

from pxr import Usd

class RigidBodyAPI:
    def __init__(self, prim: Usd.Prim) -> None: ...
    @staticmethod
    def Apply(prim: Usd.Prim) -> RigidBodyAPI: ...
    def CreateKinematicEnabledAttr(
        self, value: Any = ..., default: Any = ...
    ) -> Usd.Attribute: ...
    def GetKinematicEnabledAttr(self) -> Usd.Attribute: ...

class CollisionAPI:
    def __init__(self, prim: Usd.Prim) -> None: ...
    @staticmethod
    def Apply(prim: Usd.Prim) -> CollisionAPI: ...
    def CreateCollisionEnabledAttr(
        self, value: Any = ..., default: Any = ...
    ) -> Usd.Attribute: ...
    def GetCollisionEnabledAttr(self) -> Usd.Attribute: ...

class DriveAPI:
    @staticmethod
    def Apply(prim: Usd.Prim, name: str) -> DriveAPI: ...
