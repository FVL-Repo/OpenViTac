from typing import Any, overload

from pxr import Gf, Usd

class Tokens:
    faceVarying: str
    vertex: str
    none: str
    z: str

class XformOp:
    PrecisionDouble: Any
    def GetOpName(self) -> str: ...
    def Set(self, value: Any) -> None: ...

class Xformable(Usd.Prim):
    @overload
    def __init__(self) -> None: ...
    @overload
    def __init__(self, prim: Usd.Prim) -> None: ...
    def GetPrim(self) -> Usd.Prim: ...
    def GetOrderedXformOps(self) -> tuple[XformOp, ...] | None: ...
    def AddTranslateOp(self, precision: Any = ...) -> XformOp: ...
    def AddOrientOp(self, precision: Any = ...) -> XformOp: ...
    def ComputeLocalToWorldTransform(self, time: Usd.TimeCode) -> Gf.Matrix4d: ...

class Xform(Xformable):
    @staticmethod
    def Define(stage: Usd.Stage, path: str) -> Xform: ...

class Mesh(Xformable):
    @overload
    def __init__(self) -> None: ...
    @overload
    def __init__(self, prim: Usd.Prim) -> None: ...
    @staticmethod
    def Define(stage: Usd.Stage, path: str) -> Mesh: ...
    def GetPointsAttr(self) -> Usd.Attribute: ...
    def GetExtentAttr(self) -> Usd.Attribute: ...
    def GetNormalsAttr(self) -> Usd.Attribute: ...
    def CreateNormalsAttr(
        self, value: Any = ..., default: Any = ...
    ) -> Usd.Attribute: ...
    def GetVelocitiesAttr(self) -> Usd.Attribute: ...
    def CreateVelocitiesAttr(
        self, value: Any = ..., default: Any = ...
    ) -> Usd.Attribute: ...
    def GetAccelerationsAttr(self) -> Usd.Attribute: ...
    def GetCornerIndicesAttr(self) -> Usd.Attribute: ...
    def GetCornerSharpnessesAttr(self) -> Usd.Attribute: ...
    def GetCreaseIndicesAttr(self) -> Usd.Attribute: ...
    def GetCreaseLengthsAttr(self) -> Usd.Attribute: ...
    def GetCreaseSharpnessesAttr(self) -> Usd.Attribute: ...
    def GetHoleIndicesAttr(self) -> Usd.Attribute: ...
    def GetDoubleSidedAttr(self) -> Usd.Attribute: ...
    def GetSubdivisionSchemeAttr(self) -> Usd.Attribute: ...
    def GetFaceVertexCountsAttr(self) -> Usd.Attribute: ...
    def GetFaceVertexIndicesAttr(self) -> Usd.Attribute: ...
    def CreatePointsAttr(
        self, value: Any = ..., default: Any = ...
    ) -> Usd.Attribute: ...
    def CreateFaceVertexCountsAttr(
        self, value: Any = ..., default: Any = ...
    ) -> Usd.Attribute: ...
    def CreateFaceVertexIndicesAttr(
        self, value: Any = ..., default: Any = ...
    ) -> Usd.Attribute: ...
    def SetNormalsInterpolation(self, interpolation: str) -> None: ...
    def GetNormalsInterpolation(self) -> str: ...

class Camera(Xformable):
    @staticmethod
    def Define(stage: Usd.Stage, path: str) -> Camera: ...

class XformCache:
    def __init__(self, time: Usd.TimeCode = ...) -> None: ...
    def GetLocalToWorldTransform(self, prim: Usd.Prim) -> Gf.Matrix4d: ...

def SetStageUpAxis(stage: Usd.Stage, up_axis: str) -> None: ...
