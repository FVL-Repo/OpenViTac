                        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:orient", "xformOp:scale"]
                    }
                }
            }
        }
    }

    over "XenseWS_gelpad_right"
    {
        matrix4d xformOp:transform = ( (7.771561172376095e-16, 0.9999999999999999, -5.553659731001086e-17, 0), (1, -6.661338147750939e-16, 1.1765461393708776e-16, 0), (1.1765461393708771e-16, -5.553659731001097e-17, -1, 0), (0.08773088575501459, -0.04246530051630608, 0.7876368663550967, 1) )
