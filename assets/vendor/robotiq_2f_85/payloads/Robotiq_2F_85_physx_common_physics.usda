#usda 1.0
(
    # PhysX-only physics shared by the 2F-85 Physx_parallel_grip and Physx_compliant
    # variants: the PhysX articulation API and every PhysX convex-hull collider -- the
    # five body-link colliders and the tip collider of each Fingertip variant.
    # Identical across both PhysX grip formulations, so it lives here
    # once and is sublayered by both; the grip-specific content (mimics, outer_finger
    # welds, drive tuning, solver iteration count) stays in each variant payload.
    #
    # Everything here carries Physx* schemas, so Newton variants never sublayer it (RV.011);
    # they author their own Newton colliders in ./Robotiq_2F_85_newton_common_physics.usda.
    # The engine-neutral fingertip bodies/mass/welds live in
    # ./Robotiq_2F_85_fingertip_physics.usda. Only the tip collider of the selected
    # "Fingertip" variant exists in the composed stage; the other tip over is inert.
    # None of this composes under Physics = "None".
    #
    # The /Meshes collision groups keep the shared /Meshes colliders from colliding with
    # the articulation-body copies (each link's instanceable visuals reference /Meshes).
    defaultPrim = "Robotiq_2F_85"
    metersPerUnit = 1
    subLayers = [
        @./base.usda@
    ]
    upAxis = "Z"
)

def Xform "Robotiq_2F_85" (
    kind = "assembly"
)
{
    over Xform "Robotiq_2F_85" (
        prepend apiSchemas = ["PhysxArticulationAPI"]
        kind = "assembly"
    )
    {
        bool physxArticulation:enabledSelfCollisions = 0

        # root_joint and PhysicsArticulationRootAPI are the shared neutral defs in
        # ./Robotiq_2F_85_kinematics_physics.usda; this layer adds the PhysX articulation API.

        # Fingertip pad friction (PhysX), static = dynamic; combine mode "max" so it holds
        # against any object whose own material is softer (the default "average" would
        # drag it down). Bound to the tip colliders below. The Newton variants author
        # their own GripMaterial.
        def Scope "Physics"
        {
            def Material "GripMaterial" (
                prepend apiSchemas = ["PhysicsMaterialAPI", "PhysxMaterialAPI"]
            )
            {
                float physics:dynamicFriction = 1
                float physics:staticFriction = 1
                float physics:restitution = 0
                token physxMaterial:frictionCombineMode = "max"
            }
        }

        # Finger joint velocity cap (deg/s): the one value shared by both PhysX grip
        # variants, so they cannot drift apart. Armature and the other drive tuning stay
        # in each variant payload.
        over "Joints"
        {
            over "finger_joint"
            {
                float physxJoint:maxJointVelocity = 86
            }
        }
    }
}

over "Meshes"
{
    over "base_link"
    {
        over "Defeatured_2F_85_PAD_OPEN_basestep_01"
        {
            over "Defeatured_2F_85_PAD_OPEN_basestep" (
                prepend apiSchemas = ["PhysicsCollisionAPI", "PhysxCollisionAPI", "PhysxTriangleMeshCollisionAPI", "PhysicsMeshCollisionAPI", "PhysxConvexHullCollisionAPI"]
            )
            {
                uniform token physics:approximation = "convexHull"
                bool physics:collisionEnabled = 1
            }
        }
    }

    over "inner_finger"
    {
        over "Defeatured_2F_85_PAD_OPEN_finger4step_01"
        {
            over "Defeatured_2F_85_PAD_OPEN_finger4step" (
                prepend apiSchemas = ["PhysicsCollisionAPI", "PhysxCollisionAPI", "PhysxTriangleMeshCollisionAPI", "PhysicsMeshCollisionAPI", "PhysxConvexHullCollisionAPI"]
            )
            {
                uniform token physics:approximation = "convexHull"
                bool physics:collisionEnabled = 1
            }
        }
    }

    over "inner_knuckle"
    {
        over "Defeatured_2F_85_PAD_OPEN_finger3step_01"
        {
            over "Defeatured_2F_85_PAD_OPEN_finger3step" (
                prepend apiSchemas = ["PhysicsCollisionAPI", "PhysxCollisionAPI", "PhysxTriangleMeshCollisionAPI", "PhysicsMeshCollisionAPI", "PhysxConvexHullCollisionAPI"]
            )
            {
                uniform token physics:approximation = "convexHull"
                bool physics:collisionEnabled = 1
            }
        }
    }

    over "outer_finger"
    {
        over "Defeatured_2F_85_PAD_OPEN_finger2step_01"
        {
            over "Defeatured_2F_85_PAD_OPEN_finger2step" (
                prepend apiSchemas = ["PhysicsCollisionAPI", "PhysxCollisionAPI", "PhysxTriangleMeshCollisionAPI", "PhysicsMeshCollisionAPI", "PhysxConvexHullCollisionAPI"]
            )
            {
                uniform token physics:approximation = "convexHull"
                bool physics:collisionEnabled = 1
            }
        }
    }

    over "outer_knuckle"
    {
        over "Defeatured_2F_85_PAD_OPEN_Finger1step_01"
        {
            over "Defeatured_2F_85_PAD_OPEN_Finger1step" (
                prepend apiSchemas = ["PhysicsCollisionAPI", "PhysxCollisionAPI", "PhysxTriangleMeshCollisionAPI", "PhysicsMeshCollisionAPI", "PhysxConvexHullCollisionAPI"]
            )
            {
                uniform token physics:approximation = "convexHull"
                bool physics:collisionEnabled = 1
            }
        }
    }

    over "fingertip"
    {
        over "tip_standard"
        {
            over "Defeatured_2F_85_PAD_OPEN_fingertipsstep" (
                prepend apiSchemas = ["PhysicsCollisionAPI", "PhysxCollisionAPI", "PhysxTriangleMeshCollisionAPI", "PhysicsMeshCollisionAPI", "PhysxConvexHullCollisionAPI", "MaterialBindingAPI"]
            )
            {
                uniform token physics:approximation = "convexHull"
                bool physics:collisionEnabled = 1
                rel material:binding:physics = </Robotiq_2F_85/Robotiq_2F_85/Physics/GripMaterial>
            }
        }

        # Only present when Fingertip = "Tactile_TSF85" (the tactile payload adds
        # tip_tsf85); this over is inert otherwise. Authored here rather than in the
        # tactile payload so the sensor-case collider never composes under
        # Physics = "None" (which would otherwise leave a world-static actor with no
        # rigid-body ancestor).
        over "tip_tsf85"
        {
            over "TSF_85_case" (
                prepend apiSchemas = ["PhysicsCollisionAPI", "PhysxCollisionAPI", "PhysicsMeshCollisionAPI", "PhysxConvexHullCollisionAPI", "MaterialBindingAPI"]
            )
            {
                uniform token physics:approximation = "convexHull"
                bool physics:collisionEnabled = 1
                rel material:binding:physics = </Robotiq_2F_85/Robotiq_2F_85/Physics/GripMaterial>
            }
        }
    }

    def PhysicsCollisionGroup "CollisionGroup"
    {
        rel collection:colliders:includes = </Meshes>
        rel physics:filteredGroups
    }

    def PhysicsCollisionGroup "CollisionGroup_01"
    {
        rel collection:colliders:includes = </Robotiq_2F_85>
        rel physics:filteredGroups = </Meshes/CollisionGroup>
    }
}
