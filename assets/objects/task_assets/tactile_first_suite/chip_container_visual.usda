#usda 1.0
(
    defaultPrim = "chip_container_visual"
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "chip_container_visual"
{
    def Material "paper_material"
    {
        token outputs:surface.connect = </chip_container_visual/paper_material/surface.outputs:surface>

        def Shader "surface"
        {
            uniform token info:id = "UsdPreviewSurface"
            color3f inputs:diffuseColor = (0.77, 0.16, 0.075)
            color3f inputs:diffuseColor.connect = </chip_container_visual/paper_material/label.outputs:rgb>
            float inputs:roughness = 0.6
            token outputs:surface
        }

        def Shader "coordinates"
        {
            uniform token info:id = "UsdPrimvarReader_float2"
            token inputs:varname = "st"
            float2 outputs:result
        }

        def Shader "label"
        {
            uniform token info:id = "UsdUVTexture"
            asset inputs:file = @chip_container_label.png@
            token inputs:sourceColorSpace = "sRGB"
            float2 inputs:st.connect = </chip_container_visual/paper_material/coordinates.outputs:result>
            color3f outputs:rgb
        }
    }

    def Material "lining_material"
    {
        token outputs:surface.connect = </chip_container_visual/lining_material/surface.outputs:surface>

        def Shader "surface"
        {
            uniform token info:id = "UsdPreviewSurface"
            color3f inputs:diffuseColor = (0.75, 0.7, 0.58)
            float inputs:roughness = 0.82
            token outputs:surface
        }
    }

    def Material "rim_material"
    {
        token outputs:surface.connect = </chip_container_visual/rim_material/surface.outputs:surface>

        def Shader "surface"
        {
            uniform token info:id = "UsdPreviewSurface"
            color3f inputs:diffuseColor = (0.72, 0.74, 0.73)
            float inputs:roughness = 0.24
            token outputs:surface
        }
    }

